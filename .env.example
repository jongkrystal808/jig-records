APP_NAME=Fixture-M Lite API
APP_VERSION=0.1.0
WEB_HOST_PORT=8080
API_HOST_PORT=8010
DB_HOST_PORT=3309

# Option 1: Full SQLAlchemy URL (priority highest)
DATABASE_URL=mysql+pymysql://fixture_user:fixture_pass@db:3306/fixture_m_lite?charset=utf8mb4

# Option 2: Split DB variables (used when DATABASE_URL is empty)
DB_HOST=db
DB_PORT=3306
DB_USER=fixture_user
DB_PASSWORD=fixture_pass
DB_NAME=fixture_m_lite
