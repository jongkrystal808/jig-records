APP_NAME=Fixture-M Lite API
APP_VERSION=0.1.0
APP_ENV=development
WEB_HOST_PORT=19090
API_HOST_PORT=8010
DB_HOST_PORT=3309

# Docker test DB credentials
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=fixture_m_lite
MYSQL_USER=fixture_user
MYSQL_PASSWORD=fixture_pass

# Option 1: Full SQLAlchemy URL (priority highest)
DATABASE_URL=mysql+pymysql://fixture_user:fixture_pass@db:3306/fixture_m_lite?charset=utf8mb4

# Option 2: Split DB variables (used when DATABASE_URL is empty)
DB_HOST=db
DB_PORT=3306
DB_USER=fixture_user
DB_PASSWORD=fixture_pass
DB_NAME=fixture_m_lite

FIXTURE_IMAGE_DIR=./uploads/fixtures
AUTH_SECRET_KEY=local-docker-test-secret
AUTH_TOKEN_TTL_SECONDS=86400
DEFAULT_ADMIN_PASSWORD=admin123
